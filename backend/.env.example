NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=service_requests_dev

# Used for login tokens in a later phase. Use a long random string.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h

# The address of the React app (Vite's default)
CORS_ORIGIN=http://localhost:5173

# Password given to ALL demo accounts created by "npm run db:seed" (at least 8 characters)
SEED_PASSWORD=choose_a_demo_password