NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_real_postgres_password
DB_NAME=service_requests_dev

# Used for login tokens in a later phase. Use a long random string.
JWT_SECRET=paste_a_long_random_string_here
JWT_EXPIRES_IN=1h

# The address of the React app (Vite's default)
CORS_ORIGIN=http://localhost:5173