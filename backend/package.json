{
  "name": "service-request-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the Multi-Tenant Service Request & Approval Management System",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "knex": "tsx node_modules/knex/bin/cli.js --knexfile knexfile.ts",
    "db:migrate": "npm run knex -- migrate:latest",
    "db:rollback": "npm run knex -- migrate:rollback",
    "db:seed": "npm run knex -- seed:run",
    "db:verify": "tsx src/scripts/verifySchema.ts",
    "check:auth": "tsx src/scripts/checkAuth.ts",
    "check:users": "tsx src/scripts/checkUsers.ts",
    "check:requests": "tsx src/scripts/checkRequests.ts",
    "check:transitions": "tsx src/scripts/checkTransitions.ts",
    "check:dashboard": "tsx src/scripts/checkDashboard.ts"
    
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}